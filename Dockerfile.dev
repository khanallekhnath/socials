FROM ruby:3.4.10

WORKDIR /rails

ENV BUNDLE_PATH=/usr/local/bundle

RUN apt-get update && apt-get install -y \
    libpq-dev \
    libyaml-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock ./

RUN bundle install

COPY . .

EXPOSE 3000

CMD ["bin/rails", "server", "-b", "0.0.0.0"]